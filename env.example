# Copy to .env next to docker-compose.yml and fill in:  cp env.example .env
# Guide: docs/SERVER.md

# --- Required ---------------------------------------------------------------
# Host folder that holds your libraries, one subfolder per library (Animes/, TV/, Movies/...)
MEDIA_PATH=/srv/media
# Jellyfin > Dashboard > API Keys > + (name it "Themarr")
JELLYFIN_API_KEY=

# --- Usually fine as is ------------------------------------------------------
# Owner of the media files (`id -u` and `id -g` on the server). Themes are written as this user.
PUID=1000
PGID=1000
TZ=UTC
# ro = Themarr can only read (first test). rw = it can save themes. Nothing besides theme files is ever written.
MEDIA_ACCESS=ro

# How Themarr reaches Jellyfin. Same Docker network: http://<jellyfin container name>:8096
JELLYFIN_URL=http://jellyfin:8096
# Docker network of the Jellyfin container (`docker network ls`; compose names it <folder>_default)
JELLYFIN_NETWORK=jellyfin_default

# --- Access ------------------------------------------------------------------
# Interface the web UI listens on: 127.0.0.1 (only via VPN/proxy) or the server's LAN IP, e.g. 192.168.1.50
THEMARR_BIND=127.0.0.1
THEMARR_HOST_PORT=8686
# Address the Jellyfin buttons open. Empty = same host Jellyfin was opened on, port 8686.
# Set it when Themarr is behind a reverse proxy or THEMARR_HOST_PORT is not 8686.
THEMARR_PUBLIC_URL=

# --- Only when paths differ --------------------------------------------------
# Themarr finds media on its own when both containers see the same folders, even at different mount points.
# If it says "Folder not visible from Themarr", map Jellyfin's path to Themarr's, ';' between pairs:
# THEMARR_PATH_MAP=/media/tv=/data/TV;/media/movies=/data/Movies
THEMARR_PATH_MAP=
